{
  "manifest_version": 3,
  "name": "UPO — Universal Prompt Optimizer (Gemini)",
  "description": "Optimize selected text in editable fields with your own Google Gemini key, using a shortcut, context menu or toolbar button.",
  "version": "2.1.0",
  "author": "Arnab Mandal (hello@arnabmandal.com)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "UPO — Universal Prompt Optimizer",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "optimize-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Optimize selected text with Gemini"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
